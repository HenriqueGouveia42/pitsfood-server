{
  "name": "pitstop-server",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "db": "node scripts/prisma.js",
    "prisma": "node scripts/block-prisma.js",
    "check-branch": "node -e \"const branch = require('child_process').execSync('git branch --show-current').toString().trim(); if (branch !== 'dev') { console.error('\\nERRO: Você não está na branch \\'dev\\'! Abortando.\\n'); process.exit(1); }\"",
    "dev:api": "tsx watch --env-file=.env.dev src/server.ts",
    "dev:worker": "tsx watch --env-file=.env.dev src/worker.ts",
    "dev:ngrok": "ngrok http 3000",
    "predev": "npm run check-branch",
    "dev": "concurrently -c \"cyan,magenta,yellow\" -n \"api,worker,ngrok\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:ngrok\"",
    "test": "vitest",
    "build": "npx prisma generate && tsup src/server.ts src/worker.ts --format esm --clean --platform node",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:local": "node --env-file=.env.dev dist/server.js",
    "start:worker:local": "node --env-file=.env.dev dist/worker.js",
    "sandbox": "npx tsx sandbox.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "concurrently": "^10.0.3",
    "prisma": "^6.19.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.988.0",
    "@prisma/adapter-pg": "^6.0.1",
    "@prisma/client": "^6.19.2",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.16.3",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.10.0",
    "resend": "^6.12.3",
    "zod": "^4.3.5"
  }
}
